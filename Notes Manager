from datetime import datetime
now=datetime.now()
def add_note(note):
     try:
        with open("Notes Project.txt",'a') as file:
         file.write(f"\n{now}: {note}")
         return "Notes Added Successfully"
     except FileNotFoundError:
        return "No Notes Found"

def view_notes():
    try:
        with open("Notes Project.txt",'r') as file:
         content=file.read()
         if content.strip() !="":
          print("============== Your Notes ===================")
          return content
         else:
            return "No notes available."
    except FileNotFoundError:
        return "No notes found"


def search_note(keyword):
        try:
         with open("Notes Project.txt",'r') as file:
          for line_no,line in enumerate(file,start=1):
            if line.lower().__contains__(keyword):
                print("Note Found at line ",line_no)
                return line
          return "No matching note found."
        except FileNotFoundError:
           return "No notes found."
        
def replace_word(old_word, new_word):
        try:
         with open("Notes Project.txt",'r+') as file:
          content=file.read()
          if old_word not in content:
            return "Word not found"
          else:
            content=content.replace(old_word,new_word)
            file.seek(0)
            file.write(content)
            file.truncate()
            return "Updated"
        except FileNotFoundError:
         return "No Notes Found"

def delete_notes():
       try:
        with open("Notes Project.txt",'w') as file:
         file.write("")
         return "All notes deleted successfully"
       except FileNotFoundError:
          return "No notes Found"

def count_notes():
    try:
        with open("Notes Project.txt", "r") as file:
            count = 0
            for line in file:
                count += 1
            return count
    except FileNotFoundError:
        return "No Notes Found"
          
          


print("==================== Notes Manager ====================")
print('''
