           keyword=input("Enter keyword to search your notes: ")
           info=search_note(keyword.strip().lower())
           print(info)
        elif(option==4):
           old_word=input("Enter old word: ")
           new_word=input("Enter new word: ")
           info=replace_word(old_word.lower().strip(),new_word.lower().strip())
           print(info)
        elif(option==5):
           op=input("Are you sure you want to delete all notes? (yes/no): ")
           if op.strip().lower()=="yes":
              info=delete_notes()
              print(info)
           else:
              print("Deletion cancelled")
        elif(option==6):
           info=count_notes()
           print(info)
        else:
           print("Option shoud be between (1 to 7")
        
        option=int(input("If you want to continue please choose option (1 to 7) otherwise choose option 7: "))
        if(option==7):
         print("Thank you for using Notes Manager!")      
    except ValueError:
