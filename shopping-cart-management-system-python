def display_products(products):
    for product in products:
        print(f"ID: {product['id']}")
        print(f"Name: {product['name']}")
        print(f"Price: {product['price']}")
        print("")
        
def search_product(products, keyword):
    for product in products:
        if product["name"].lower()==keyword.lower().strip():
            return f"Product Found\n\nID: {product['id']}\nName: {product['name']}\nPrice: {product['price']}"       
    return "Product Not Found"


cart=[]
def add_to_cart(products, cart, product_id):
    for product in products:
        if product["id"]==product_id:
            for item in cart:
                if item["id"]==product_id:
                 return "Product already in cart"
            cart.append(product)
            return f"{product['name']} added to cart"
    return "Prduct Not Found"

def remove_from_cart(cart, product_id):
    for product in cart:
        if product["id"]==product_id:
            index1=cart.index(product)
            cart.pop(index1)
            return f"{product['name']} removed"
    return "Product Not Found In Cart"


def calculate_total(cart):
    if len(cart)==0:
        return "Your cart is empty"
    else:
        total=0
        item=0
        for product in cart:
            item=item+1
            total=total+product["price"]
        return f"Item={item}\nTotal Bill: {total}"


