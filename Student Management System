students=[]

def add_student():
    Name=input("Enter Student Name: ")
    Roll_Number=input("Enter Student Roll no: ")
    Username=input("Enter Student username for Login: ")
    Password=input("Enter Student Password for Login: ")
    Department=input("Enter Student Department: ")
    CGPA=float(input("Enter Student CGPA: "))
    student=Student(Name,Roll_Number,Username,Password,Department,CGPA)
    students.append(student)
    print("Student Added Successfully")
    #admin_panel()
    
def view_students():
   if len(students)==0:
      print("There is no Student in Record Found")
   else:
    for student in students:
      student.display()
  
    
def search_student():
    n=0
    rollno=input("Enter Student Roll no to search: ")
    for student in students:
       if student.Roll_Number==rollno:
          n=1
          print("Student Found")
          print("Here is the Student Details:")
          student.display()
          break
    if n==0:
     print("Student Not Found")
    #admin_panel()
       
def update_student():
    found=False
    rollno=input("Enter Student Rollno Whoose information you want to change: ")
    for student in students:
       if student.Roll_Number==rollno:
          found=True
          print("Student Found\nCurrent Details:")
          student.display()
          student.Name=input("Enter Student Name: ")
          student.Roll_Number=input("Enter Student Roll no: ")
          student.Username=input("Enter Student username for Login: ")
          student.Password=input("Enter Student Password for Login: ")
          student.Department=input("Enter Student Department: ")
          student.CGPA=float(input("Enter Student CGPA: "))
          print("Student Information Successfully Updated")
          break
    if not found:
     print("Student Not Found")
    #admin_panel()
          


def delete_student():
   found=False
   rollno=input("Enter Student Roll Number to delete: ")
   for student in students:
       if student.Roll_Number==rollno:
          found=True
          print("Student Found")
          students.remove(student)
          print("Student Information Deleted Successfully")
          break
   if not found:
     print("Student Not Found")
   #admin_panel()
    
    
def logout():
    print("Logged out successfully.")
    main_menu()
    

class Student:
   def __init__(self,Name,Roll_Number,Username,Password,Department,CGPA):
      self.Name=Name
      self.Roll_Number=Roll_Number
      self.Username=Username
      self.Password=Password
      self.Department=Department
      self.CGPA=CGPA
   def display(self):
      print(f'''{colorama.Fore.BLUE}
Name= {self.Name}
Roll No= {self.Roll_Number}
Username= {self.Username}
Department= {self.Department}
CGPA= {self.CGPA}{colorama.Fore.RESET}
            ''')

